{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "esp32",
      "displayName": "ESP32 (bench)",
      "description": "Bench measurement image for ESP32, Xtensa LX6, 240 MHz",
      "binaryDir": "${sourceDir}/build/esp32",
      "cacheVariables": {
        "IDF_TARGET": "esp32",
        "SDKCONFIG": "${sourceDir}/build/esp32/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.esp32;sdkconfig.defaults.aes_hw"
      }
    },
    {
      "name": "esp32c3",
      "displayName": "ESP32-C3 (bench)",
      "description": "Bench measurement image for ESP32-C3, RISC-V, 160 MHz",
      "binaryDir": "${sourceDir}/build/esp32c3",
      "cacheVariables": {
        "IDF_TARGET": "esp32c3",
        "SDKCONFIG": "${sourceDir}/build/esp32c3/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.esp32c3;sdkconfig.defaults.aes_hw"
      },
      "vendor": {
        "espressif/vscode-esp-idf": {
          "schemaVersion": 1,
          "settings": [
            {
              "type": "openOCD",
              "value": {
                "debugLevel": 2,
                "configs": [
                  "board/esp32c3-ftdi.cfg"
                ],
                "args": []
              }
            }
          ]
        }
      }
    },
    {
      "name": "esp32-aes-sw",
      "displayName": "ESP32 (bench, AES sw-only sweep)",
      "description": "AES-128-GCM software-only sweep, ESP32",
      "binaryDir": "${sourceDir}/build/esp32-aes-sw",
      "cacheVariables": {
        "IDF_TARGET": "esp32",
        "SDKCONFIG": "${sourceDir}/build/esp32-aes-sw/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.esp32;sdkconfig.defaults.aes_sw"
      }
    },
    {
      "name": "esp32c3-aes-sw",
      "displayName": "ESP32-C3 (bench, AES sw-only sweep)",
      "description": "AES-128-GCM software-only sweep, ESP32-C3",
      "binaryDir": "${sourceDir}/build/esp32c3-aes-sw",
      "cacheVariables": {
        "IDF_TARGET": "esp32c3",
        "SDKCONFIG": "${sourceDir}/build/esp32c3-aes-sw/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.esp32c3;sdkconfig.defaults.aes_sw"
      }
    },
    {
      "name": "esp32-gate64",
      "displayName": "ESP32 (bench, Phase 4 Bachmann gate)",
      "description": "Bachmann opt64 32 kB calibration gate, ESP32",
      "binaryDir": "${sourceDir}/build/esp32-gate64",
      "cacheVariables": {
        "IDF_TARGET": "esp32",
        "SDKCONFIG": "${sourceDir}/build/esp32-gate64/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.esp32;sdkconfig.defaults.gate64"
      }
    },
    {
      "name": "esp32c3-gate64",
      "displayName": "ESP32-C3 (bench, Phase 4 Bachmann gate)",
      "description": "Bachmann opt64 32 kB calibration gate, ESP32-C3",
      "binaryDir": "${sourceDir}/build/esp32c3-gate64",
      "cacheVariables": {
        "IDF_TARGET": "esp32c3",
        "SDKCONFIG": "${sourceDir}/build/esp32c3-gate64/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.esp32c3;sdkconfig.defaults.gate64"
      }
    }
  ]
}